{
  "info": {
    "name": "School Management API",
    "description": "APIs for adding and listing schools",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Check",
      "request": {
        "method": "GET",
        "url": "https://school-management-api-9cey.onrender.com/"
      }
    },
    {
      "name": "Add School",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Innovation Public School\",\n  \"address\": \"Tech Park Road\",\n  \"latitude\": 40.7505,\n  \"longitude\": -73.9972\n}"
        },
        "url": "https://school-management-api-9cey.onrender.com/addSchool"
      },
      "response": [
        {
          "name": "Success",
          "status": "Created",
          "code": 201,
          "body": "{\n  \"success\": true,\n  \"message\": \"School added successfully\"\n}"
        },
        {
          "name": "Failure",
          "status": "Bad Request",
          "code": 400,
          "body": "{\n  \"success\": false,\n  \"message\": \"Invalid input\"\n}"
        }
      ]
    },
    {
      "name": "List Schools",
      "request": {
        "method": "GET",
        "url": "https://school-management-api-9cey.onrender.com/listSchools?latitude=40.7128&longitude=-74.0060"
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"schools\": []\n}"
        },
        {
          "name": "Failure",
          "status": "Bad Request",
          "code": 400,
          "body": "{\n  \"success\": false,\n  \"message\": \"Latitude and longitude required\"\n}"
        }
      ]
    }
  ]
}